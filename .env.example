# ============================================================
# EmpleaPerú — Variables de entorno (Ejemplo)
# ============================================================
# PRODUCCIÓN (Vercel + Supabase PostgreSQL + Supabase Storage):
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
AUTH_SECRET="REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES"
NEXT_PUBLIC_APP_URL="https://empleaperu.vercel.app"

# Supabase Storage (bucket privado "resumes" — solo servidor)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REEMPLAZAR_POR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="resumes"

# Opciones de seguridad en producción (mantener en false)
NEXT_PUBLIC_SHOW_DEMO_HELPER="false"
ALLOW_DEV_RESET_TOKEN="false"

# Credenciales para seed de producción (opcionales, solo al sembrar BD)
# DEMO_ADMIN_PASSWORD=""
# DEMO_COMPANY_PASSWORD=""
# DEMO_CANDIDATE_PASSWORD=""

# Modo local alternativo (SQLite + disco privado):
# DATABASE_URL="file:./dev.db"
# STORAGE_DIR="./storage/private"
# NEXT_PUBLIC_SHOW_DEMO_HELPER="true"
# ALLOW_DEV_RESET_TOKEN="true"

# Integración IA externa opcional (desactivada por defecto)
AI_ADAPTER_ENABLED="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
